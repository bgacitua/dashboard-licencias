# ====================================================
# Base de Datos Principal: PostgreSQL rh_cramer (VPS host)
# ====================================================
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=rh_cramer
DB_USER=usuario_global
DB_PASSWORD=your_password_here

# ====================================================
# Base de Datos Marcas: SQL Server MorphoManager
# ====================================================
MARCAS_DB_SERVER=192.9.200.84
MARCAS_DB_USER=rrhh_morpho
MARCAS_DB_PASSWORD=your_password_here
MARCAS_DB_NAME=MorphoManager
MARCAS_DB_DRIVER=ODBC Driver 18 for SQL Server

# ====================================================
# JWT
# ====================================================
JWT_SECRET_KEY=cambia-esto-por-una-clave-segura-y-larga
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ====================================================
# BUK API
# ====================================================
BUK_API_BASE_URL=https://cramer.buk.cl/api/v1/chile
BUK_API_KEY=your_buk_api_key_here

# ====================================================
# Azure App / Graph API (envío de correos vía Office 365)
# Obtener desde portal.azure.com → App registrations → tu app
# ====================================================
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
# Cuenta de servicio desde la que se envían los correos
SMTP_FROM=bgacitua@cramer.cl
SMTP_PASSWORD=your_password_here
# Destinatarios en copia (separados por coma, sin espacios)
EMAIL_CC_LIST=correo1@cramer.cl,correo2@cramer.cl
# URI de callback registrada en Azure App Registration → Authentication
# Debe usar HTTPS — Microsoft rechaza HTTP en dominios no-localhost
AZURE_REDIRECT_URI=https://personas.cramer.cl/api/v1/contract-alerts/auth/callback
# Ruta donde se guarda el refresh token (debe ser un volumen Docker persistente)
TOKEN_STORAGE_PATH=/app/data/ms_token.json

# ====================================================
# URL pública para botones de respuesta en correos de alerta
# Usar HTTP para evitar advertencias de certificado en clientes internos
# ====================================================
PUBLIC_URL=http://personas.cramer.cl

# ====================================================
# Scheduler de alertas automáticas
# ====================================================
ALERTS_SCHEDULER_ENABLED=False
ALERTS_SCHEDULER_HOUR=8
ALERTS_SCHEDULER_MINUTE=0
ALERTS_SCHEDULER_TIMEZONE=America/Santiago
ALERTS_N8N_WEBHOOK_URL=

# ====================================================
# Horas extras fin de semana
# ====================================================
OVERTIME_SCHEDULER_ENABLED=False
OVERTIME_SEND_DAY=thu
OVERTIME_SEND_HOUR=9
OVERTIME_SEND_MINUTE=0
OVERTIME_DEADLINE_DAY=fri
OVERTIME_DEADLINE_HOUR=14
OVERTIME_DEADLINE_MINUTE=0
# Destinatarios del consolidado, separados por ;
OVERTIME_SUMMARY_TO=
# Modo prueba: desvía TODOS los correos de horas extras a esta casilla. Vaciar en producción.
OVERTIME_TEST_EMAIL=

# Modo prueba GLOBAL de correo: desvía TODO correo saliente a esta casilla y vacía
# CC/BCC (alertas de contratos, horas extras, salidas, retorno). Vaciar en producción.
EMAIL_TEST_REDIRECT=

# === Aviso de salida de personal ===
SALIDA_PERSONAL_TO=
# Copias, separadas por ;
SALIDA_PERSONAL_CC=
# Remitente. Vacío = la cuenta autenticada en Graph. Requiere SendAs sobre ese buzón.
SALIDA_PERSONAL_FROM=

# ====================================================
# CORS (separar con coma si hay varios orígenes)
# ====================================================
CORS_ORIGINS=http://personas.cramer.cl,https://personas.cramer.cl

# ====================================================
# Pool de conexiones (opcionales)
# ====================================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
MARCAS_DB_POOL_SIZE=2
MARCAS_DB_MAX_OVERFLOW=5
